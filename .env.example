# ============================================================
# 美股短线选股系统 - 环境变量配置
# 复制此文件为 .env 并填入你的真实密钥
# ============================================================

# Finnhub API Key (免费注册: https://finnhub.io/register)
FINNHUB_API_KEY=your_finnhub_api_key_here

# MiniMax API Key (用于新闻语义打标)
MINIMAX_API_KEY=your_minimax_api_key_here

# 阿里云 DashScope API Key (用于 compare_llms 多模型对比)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Google Gemini API Key (用于 compare_llms Gemini 模型)
GEMINI_API_KEY=your_gemini_api_key_here

# Discord Webhook URL (在 Discord 频道设置 > 集成 > Webhook 中创建)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# 可选: 关闭逐条新闻语义打标, 仅保留 Finnhub 新闻 + live LLM funnel
ENABLE_SEMANTIC_TAGGING=1

# 可选: 限制单股新闻语义打标文章数
SEMANTIC_MAX_ARTICLES_PER_STOCK=20

# 可选: live LLM 请求超时秒数
LLM_TIMEOUT_SECONDS=90

# 可选: 允许 ETF 进入候选池与 LLM 流程
ALLOW_ETF_CANDIDATES=0

# ============================================================
# Screener Arena Automation
# ============================================================

# Arena submit target
SCREENER_ARENA_URL=http://127.0.0.1:8876
SCREENER_ARENA_API_KEY=
CLAWBOT_ARENA_ROOT=

# Optional: place screener picks into Poly Arena after Arena submit
SCREENER_POLY_BOT=
SCREENER_POLY_ARENA_URL=http://127.0.0.1:8046
